# BetViero environment example
# Copy this file to .env and replace the placeholder values with real secrets.
# Never commit the real .env file.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# GitHub Actions uses this secret name in .github/workflows/tennis_tracker.yml.
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_SCHEMA=public
TENNIS_SUPABASE_SCHEMA=tennis

# The Odds API
# Used by tennis and legacy LoL odds scripts.
ODDS_API_KEY=your-the-odds-api-key
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
THE_ODDS_API_TIMEOUT_SECONDS=30

# Tennis odds config
TENNIS_ODDS_SPORT_KEY=tennis_atp
TENNIS_ODDS_REGIONS=eu,uk
TENNIS_ODDS_MARKETS=h2h,totals,spreads
TENNIS_ODDS_FORMAT=decimal

# PandaScore LoL
PANDASCORE_API_KEY=your-pandascore-api-key
PANDASCORE_BASE_URL=https://api.pandascore.co
PANDASCORE_LOOKAHEAD_HOURS=96

# Telegram bot, only needed if you use Telegram alerts
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# LoL paths, relative to project root
MODEL_ARTIFACT_PATH=lol/models/modelo_multimarket.pkl
TRAINING_DATASET_PATH=lol/data/processed/firstblood_training_dataset.csv
TRAINING_DATASET_PARQUET_PATH=lol/data/processed/firstblood_training_dataset.parquet
ORACLES_ELIXIR_RAW_DIR=lol/data/raw/oracles_elixir
ORACLES_ELIXIR_CANONICAL_PARQUET_PATH=lol/data/processed/oracles_elixir_team_rows_training.parquet
ORACLES_ELIXIR_2026_DRIVE_URL=
PREDICTIONS_INPUT_PATH=lol/data/predictions/upcoming_multimarket_predictions.csv
TEAM_NAME_OVERRIDES_PATH=lol/data/config/team_name_overrides.json

# LoL legacy odds listener
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_SPORT_KEY=esports_league_of_legends
ODDS_MARKET_KEY=h2h
ODDS_REGION=eu
ODDS_BOOKMAKERS=
ODDS_COMMENCE_LOOKAHEAD_HOURS=36
ODDS_SNAPSHOTS_OUTPUT_PATH=lol/data/paper_trading/odds_snapshots.jsonl
EV_SIGNALS_OUTPUT_PATH=lol/data/paper_trading/ev_signals.jsonl
LISTENER_STATE_PATH=lol/data/paper_trading/listener_state.json
LISTENER_POLL_MINUTES=30
VALUE_EDGE_THRESHOLD=0.025
MIN_EV_THRESHOLD=0.02
DEFAULT_STAKE_UNITS=1.0

# Bankroll / staking
BOT_POLL_INTERVAL_SECONDS=5
BANKROLL_AMOUNT=26
KELLY_FRACTION=0.25
MAX_STAKE_AMOUNT=1.0

# OCR, optional. Leave empty unless Tesseract is installed outside PATH.
TESSERACT_CMD_PATH=
